---
import Base from '../layouts/Base.astro';
---

<Base
  title="공간 음향 실험실 — Web Audio API"
  description="PannerNode 의 HRTF 패닝으로 음원과 청취자의 거리·방향에 따른 입체음향을 3D 공간에서 실험합니다."
  active="/spatial"
  fullscreen={true}
  footer={false}
>
  <div id="scene" class="via-scene"></div>

  <!-- 좌상단: 계측 리드아웃 -->
  <div class="via-hud" id="hud">
    <div class="via-hud__title">SPATIAL METERING</div>
    <div class="via-readout">
      <span class="via-readout__k">DISTANCE</span>
      <span class="via-readout__v" id="v-dist">—</span>
      <span class="via-readout__u">m</span>
    </div>
    <div class="via-readout">
      <span class="via-readout__k">LEVEL</span>
      <span class="via-readout__v" id="v-gain">—</span>
      <span class="via-readout__u">dB</span>
    </div>
    <div class="via-readout">
      <span class="via-readout__k">AZIMUTH</span>
      <span class="via-readout__v" id="v-az">—</span>
      <span class="via-readout__u">°</span>
    </div>
  </div>

  <!-- 우하단: 신호 제어 패널 -->
  <div class="via-scene-panel" id="panel">
    <div class="via-sec-head mb-3">
      <span class="via-sec-head__icon"><i class="bi bi-sliders"></i></span>
      <div>
        <h2>신호 제어</h2>
        <p class="via-sec-head__sub">SIGNAL / CONTROL</p>
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label" for="file">음원 파일</label>
      <label id="filelabel" for="file" class="via-dropzone">오디오 파일 선택 (mp3 · wav …)</label>
      <input type="file" id="file" accept="audio/*" class="d-none" />
    </div>

    <div class="d-grid gap-2 mb-3" style="grid-template-columns:1fr 1fr">
      <button id="play" class="btn btn-fill" disabled>
        <i class="bi bi-play-fill"></i> 재생
      </button>
      <button id="tone" class="btn btn-primary">
        <i class="bi bi-broadcast-pin"></i> 테스트 신호
      </button>
    </div>

    <div class="mb-1 d-flex justify-content-between align-items-baseline">
      <label class="form-label mb-0" for="headrot">머리 방향</label>
      <span class="badge is-primary" id="rotval">0°</span>
    </div>
    <input type="range" class="form-range" id="headrot" min="-180" max="180" value="0" step="1" />

    <div class="via-scene-panel__hint">
      <span><i class="bi bi-circle-fill" style="color:var(--via-warm)"></i> 스피커 · <i
          class="bi bi-circle-fill"
          style="color:var(--via-primary)"></i> 청취자 — 드래그로 이동</span>
      <span>빈 곳 드래그 = 시점 회전 · 휠 = 확대/축소</span>
      <span class="text-warm"><i class="bi bi-headphones"></i> 입체음향은 헤드폰에서 확인하세요</span>
    </div>
  </div>
</Base>

<style>
  .via-scene {
    position: absolute;
    inset: 0;
    cursor: grab;
    touch-action: none;
  }
  .via-scene.is-dragging {
    cursor: grabbing;
  }
  .via-scene :global(canvas) {
    display: block;
  }

  .via-hud {
    position: absolute;
    top: 20px;
    left: 20px;
    padding: 1rem 1.15rem;
    border-radius: var(--via-radius-lg);
    background: var(--via-bg);
    box-shadow: var(--via-shadow-md);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    pointer-events: none;
  }
  .via-hud__title {
    font-family: var(--via-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: var(--via-muted);
    margin-bottom: 0.25rem;
  }
  .via-hud .via-readout__k {
    width: 74px;
  }
  .via-hud .via-readout__v {
    min-width: 84px;
  }

  .via-scene-panel {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 292px;
    padding: 1.25rem;
    border-radius: var(--via-radius-xl);
    background: var(--via-bg);
    box-shadow: var(--via-shadow-lg);
  }
  .via-scene-panel .btn {
    font-size: 0.8rem;
    padding: 0.6rem 0.4rem;
    white-space: nowrap;
  }
  .via-scene-panel__hint {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 1.1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--via-hr);
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--via-muted);
  }
  .via-scene-panel__hint i {
    font-size: 0.55rem;
    vertical-align: middle;
  }

  .via-dropzone {
    display: block;
    width: 100%;
    padding: 0.7rem 0.8rem;
    border-radius: var(--via-radius);
    background: var(--via-bg);
    box-shadow: var(--via-inset-sm);
    font-family: var(--via-mono);
    font-size: 0.74rem;
    color: var(--via-muted);
    text-align: center;
    cursor: pointer;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color var(--via-ease);
  }
  .via-dropzone:hover {
    color: var(--via-heading);
  }
  .via-dropzone.is-loaded {
    color: var(--via-warm-ink);
    box-shadow: var(--via-shadow-sm);
  }

  @media (max-width: 900px) {
    /* 모바일: HUD 는 가로 한 줄, 패널은 낮게 — 3D 씬을 최대한 남긴다 */
    .via-hud {
      top: 10px;
      left: 10px;
      right: 10px;
      flex-direction: row;
      justify-content: space-between;
      gap: 0.5rem;
      padding: 0.6rem 0.9rem;
    }
    .via-hud__title {
      display: none;
    }
    .via-hud .via-readout {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }
    .via-hud .via-readout__k,
    .via-hud .via-readout__v {
      width: auto;
      min-width: 0;
    }
    .via-hud .via-readout__v {
      font-size: 1.05rem;
    }
    .via-hud .via-readout__u {
      display: none;
    }

    .via-scene-panel {
      left: 10px;
      right: 10px;
      bottom: 10px;
      width: auto;
      padding: 0.9rem 1rem;
    }
    .via-scene-panel .via-sec-head {
      margin-bottom: 0.75rem !important;
    }
    .via-scene-panel__hint {
      margin-top: 0.8rem;
      padding-top: 0.7rem;
      font-size: 0.64rem;
    }
    .via-dropzone {
      padding: 0.55rem 0.7rem;
    }
  }

</style>

<script>
  import '../scripts/spatial';
</script>
